# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in your key:
#
#   cp .env.example .env.local
#
# `.env.local` is git-ignored. Never commit a real key.
#
# IMPORTANT: none of these are prefixed with NEXT_PUBLIC_, which means Next.js
# will NEVER inline them into the client bundle. They are readable only from
# server code (route handlers under app/api/**). See README "Client/server
# boundary".
# ---------------------------------------------------------------------------

# Required. Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-replace-me

# Optional. Set if your key belongs to a specific org / project.
# OPENAI_ORG_ID=org_...
# OPENAI_PROJECT_ID=proj_...

# ---------------------------------------------------------------------------
# Optional model + generation overrides.
# Defaults live in lib/config.ts — these env vars let you change them per
# environment without editing code.
# ---------------------------------------------------------------------------

# Text model used for the campaign concept (Responses API).
# OPENAI_TEXT_MODEL=gpt-5.6-terra

# Reasoning effort: none | low | medium | high | xhigh | max
# OPENAI_REASONING_EFFORT=low

# Image model used for the campaign direction visuals.
# OPENAI_IMAGE_MODEL=gpt-image-2

# Image size (WIDTHxHEIGHT). gpt-image-2 accepts arbitrary sizes where both
# dimensions are divisible by 16 and the aspect ratio is between 1:3 and 3:1.
# OPENAI_IMAGE_SIZE=1024x1024

# Image quality: low | medium | high
# OPENAI_IMAGE_QUALITY=medium

# Image output format: png | webp | jpeg
# OPENAI_IMAGE_FORMAT=webp
